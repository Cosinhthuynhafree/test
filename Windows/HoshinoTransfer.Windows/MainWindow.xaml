<Window x:Class="HoshinoTransfer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoshinoTransfer" Width="1180" Height="780" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#0B0E14" Foreground="#EDF0F7"
        FontFamily="Segoe UI" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#131826" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#1A2130" />
        <SolidColorBrush x:Key="Line" Color="#232B3D" />
        <SolidColorBrush x:Key="Muted" Color="#9AA3B5" />
        <SolidColorBrush x:Key="Accent" Color="#7C6CFF" />
        <SolidColorBrush x:Key="AccentSoft" Color="#2A2547" />
        <SolidColorBrush x:Key="Good" Color="#4ADE80" />
        <SolidColorBrush x:Key="Bad" Color="#F87171" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.87" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.7" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="Foreground" Value="#C9D0DE" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#592A33" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A99CFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AEB5C7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavRoot" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavRoot" Property="Background" Value="#1B2233" /><Setter Property="Foreground" Value="#EDF0F7" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavRoot" Property="Opacity" Value="0.75" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#10141F" />
            <Setter Property="Foreground" Value="#EDF0F7" />
            <Setter Property="CaretBrush" Value="#EDF0F7" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BoxRoot" Property="BorderBrush" Value="#4A3FA8" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BoxRoot" Property="BorderBrush" Value="#313B52" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#EDF0F7" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6E7789" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="30" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ProgressStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#1E2534" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="#17301F" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Good}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ListBoxBase" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#EDF0F7" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemRoot" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#1B2233" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#232C42" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="LoginView">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsAuthenticated}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.75,0.1" Center="0.75,0.1" RadiusX="0.95" RadiusY="0.95">
                    <GradientStop Color="#191531" Offset="0" />
                    <GradientStop Color="#0B0E14" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
            <Border Width="430" Padding="36" Background="#141927" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="16" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7C6CFF" Offset="0" /><GradientStop Color="#4B3FB8" Offset="1" /></LinearGradientBrush></Border.Background>
                        <TextBlock Text="H" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="HoshinoTransfer" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="Files between your devices, verified end to end." Foreground="{StaticResource Muted}" Margin="0,7,0,26" />
                    <TextBlock Text="DISPLAY NAME" Margin="0,0,0,6">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRegisterMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14">
                        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource InputBox}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRegisterMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBox.Style>
                    </TextBox>
                    <TextBlock Text="USERNAME" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,0,0,14" />
                    <TextBlock Text="PASSWORD" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" Background="#10141F" Foreground="#EDF0F7" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,9" FontSize="13" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button Content="{Binding BusyLabel}" Command="{Binding SubmitAuthCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" />
                    <Button Content="{Binding AuthModePrompt}" Command="{Binding ToggleAuthModeCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="TLS · scrypt-protected passwords · session kept in Windows Credential Manager" Foreground="#6E7789" FontSize="10.5" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,14,0,0" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="AppView">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsAuthenticated}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="236" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0F131D" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="16,20">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="6,0,0,26">
                            <Border Width="34" Height="34" CornerRadius="11" Margin="0,0,11,0">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7C6CFF" Offset="0" /><GradientStop Color="#4B3FB8" Offset="1" /></LinearGradientBrush></Border.Background>
                                <TextBlock Text="H" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="HoshinoTransfer" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="WORKSPACE" Style="{StaticResource SectionLabel}" Margin="12,0,0,8" />
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Home">
                            <StackPanel Orientation="Horizontal" Margin="8,8"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" /><TextBlock Text="Home" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Transfer">
                            <StackPanel Orientation="Horizontal" Margin="8,8"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE895;" /><TextBlock Text="Transfer" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Devices">
                            <StackPanel Orientation="Horizontal" Margin="8,8"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE772;" /><TextBlock Text="Devices" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Friends">
                            <StackPanel Orientation="Horizontal" Margin="8,8"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE716;" /><TextBlock Text="Friends" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Chat">
                            <StackPanel Orientation="Horizontal" Margin="8,8"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE8BD;" /><TextBlock Text="Chat" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="History">
                            <StackPanel Orientation="Horizontal" Margin="8,8"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE81C;" /><TextBlock Text="History" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal" Margin="8,8"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="12" Margin="4,16,4,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentSoft}" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding SignedInName}" Foreground="#B8ADFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SignedInName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Signed in securely" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Button Style="{StaticResource NavButton}" Command="{Binding LogoutCommand}">
                            <StackPanel Orientation="Horizontal" Margin="8,8"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE8AB;" /><TextBlock Text="Sign out" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid />
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="34,26,34,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,22">
                    <TextBlock Text="{Binding Page}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PageDescription}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <ContentControl Grid.Row="1" Content="{Binding Page}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Grid>
                                <ScrollViewer x:Name="HomePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" BorderBrush="#2B2547">
                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1A1533" Offset="0" /><GradientStop Color="#131826" Offset="1" /></LinearGradientBrush></Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Welcome back" Foreground="{StaticResource Muted}" FontSize="12" />
                                                    <TextBlock Text="{Binding DataContext.SignedInName, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                                                    <TextBlock Text="Every byte you send is chunk-streamed and SHA-256 verified by the relay." Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="540" Margin="0,8,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                        <Button Content="Send files" Command="{Binding DataContext.OpenFilesCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" />
                                                        <Button Content="Find friends" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Friends" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Width="52" Height="52" CornerRadius="16" Background="{StaticResource AccentSoft}" VerticalAlignment="Top"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="#B8ADFF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            </Grid>
                                        </Border>
                                        <UniformGrid Columns="3" Margin="0,0,0,14">
                                            <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                                                <StackPanel>
                                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="#B8ADFF" FontSize="16" />
                                                    <TextBlock Text="{Binding DataContext.Friends.Count, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                                                    <TextBlock Text="People" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="7,0">
                                                <StackPanel>
                                                    <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" Foreground="#8DD9AE" FontSize="16" />
                                                    <TextBlock Text="{Binding DataContext.Devices.Count, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                                                    <TextBlock Text="Devices" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="#F5C065" FontSize="16" />
                                                    <TextBlock Text="{Binding DataContext.Transfers.Count, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                                                    <TextBlock Text="Transfers" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="Service connection" Style="{StaticResource CardTitle}" />
                                                    <Button DockPanel.Dock="Right" Content="Check" Command="{Binding DataContext.RefreshBackendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" Padding="14,6" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding DataContext.BackendStatus, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer x:Name="FriendsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Find people" Style="{StaticResource CardTitle}" />
                                                <DockPanel Margin="0,11,0,8">
                                                    <Button DockPanel.Dock="Right" Content="Search" Command="{Binding DataContext.SearchUsersCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                                    <TextBox Text="{Binding DataContext.SearchQuery, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                                </DockPanel>
                                                <ListBox ItemsSource="{Binding DataContext.SearchResults, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SelectedSearchUser, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ListBoxBase}" MaxHeight="146">
                                                    <ListBox.ItemTemplate><DataTemplate>
                                                        <Border Padding="9,7">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="Add" Command="{Binding DataContext.AddSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" Padding="12,5" VerticalAlignment="Center" />
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                                    <TextBlock Text="{Binding Username}" Foreground="{StaticResource Muted}" FontSize="11" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Add by username" Style="{StaticResource CardTitle}" />
                                                <DockPanel Margin="0,11,0,0">
                                                    <Button DockPanel.Dock="Right" Content="Send request" Command="{Binding DataContext.RequestFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                                    <TextBox Text="{Binding DataContext.FriendUsername, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="People" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                                <ListBox ItemsSource="{Binding DataContext.Friends, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SelectedFriend, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ListBoxBase}" MinHeight="150">
                                                    <ListBox.ItemTemplate><DataTemplate>
                                                        <Border Padding="9,8">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="#B8ADFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding User.Initials, Mode=OneWay}" Foreground="#B8ADFF" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                                                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#4B5568" /><Style.Triggers><DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Fill" Value="{StaticResource Good}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                                            </Ellipse>
                                                                            <TextBlock Text="{Binding User.DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding User.Username}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                                <WrapPanel Margin="0,12,0,0">
                                                    <Button Content="Accept" Command="{Binding DataContext.AcceptFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                                    <Button Content="Reject" Command="{Binding DataContext.RejectFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                                                    <Button Content="Open chat" Command="{Binding DataContext.SelectFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                                    <Button Content="Remove" Command="{Binding DataContext.RemoveFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                                                    <Button Content="Block" Command="{Binding DataContext.BlockFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource DangerButton}" Margin="0,0,8,8" />
                                                    <Button Content="Unblock" Command="{Binding DataContext.UnblockFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" Margin="0,0,0,8" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                                                <StackPanel>
                                                    <TextBlock Text="Register this computer" Style="{StaticResource CardTitle}" />
                                                    <DockPanel Margin="0,11,0,0">
                                                        <Button DockPanel.Dock="Right" Content="Register" Command="{Binding DataContext.RegisterDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                                        <TextBox Text="{Binding DataContext.DeviceName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Width="300">
                                                <StackPanel>
                                                    <TextBlock Text="Pair a second device" Style="{StaticResource CardTitle}" />
                                                    <TextBlock Text="Single-use code, expires in 5 minutes. The other device must be signed in to this account." Style="{StaticResource MutedText}" Margin="0,6,0,10" />
                                                    <WrapPanel>
                                                        <Button Content="Create code" Command="{Binding DataContext.CreatePairingCodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" />
                                                        <TextBlock Text="{Binding DataContext.PairingCode, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="19" FontWeight="Bold" Foreground="#B8ADFF" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    </WrapPanel>
                                                    <Border Background="#10141F" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="8" HorizontalAlignment="Left" Margin="0,10,0,0">
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.HasPairingQr, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <Image Source="{Binding DataContext.PairingQrImage, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Width="132" Height="132" />
                                                    </Border>
                                                    <DockPanel Margin="0,10,0,0">
                                                        <Button DockPanel.Dock="Right" Content="Pair" Command="{Binding DataContext.PairDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                                        <TextBox Text="{Binding DataContext.PairingCode, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" MaxLength="8" ToolTip="Eight-digit pairing code" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="Registered devices" Style="{StaticResource CardTitle}" />
                                                    <Button DockPanel.Dock="Right" Content="Revoke selected" Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource DangerButton}" Padding="13,6" />
                                                </DockPanel>
                                                <ListBox ItemsSource="{Binding DataContext.Devices, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SelectedDevice, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ListBoxBase}" Margin="0,10,0,0">
                                                    <ListBox.ItemTemplate><DataTemplate>
                                                        <Border Padding="9,8">
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}">
                                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" />
                                                                </Border>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource SurfaceAlt}">
                                                                        <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" Foreground="#8DD9AE" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="13" />
                                                                        <TextBlock Text="{Binding Platform}" Foreground="{StaticResource Muted}" FontSize="11" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="Lightning cable transfer is unavailable on this transport stack; it is never shown as active." Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid x:Name="ChatPage" Visibility="Collapsed">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                                        <DockPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DataContext.CurrentPeerName, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding DataContext.TypingStatus, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Foreground="#B8ADFF" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="Authenticated SSE" Foreground="{StaticResource Good}" FontSize="11" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding DataContext.Messages, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ListBoxBase}" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Grid Margin="10,3">
                                                <Border HorizontalAlignment="Right" MaxWidth="480" Background="#7C6CFF" CornerRadius="14,14,4,14" Padding="12,8">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="White" FontSize="13" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding Timestamp}" Foreground="#D9D3FF" FontSize="10" />
                                                            <TextBlock Text="{Binding Status}" Foreground="#D9D3FF" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border HorizontalAlignment="Left" MaxWidth="480" Background="{StaticResource SurfaceAlt}" CornerRadius="14,14,14,4" Padding="12,8">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#EDF0F7" FontSize="13" />
                                                        <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                                        <Button DockPanel.Dock="Right" Content="Send" Command="{Binding DataContext.SendMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                        <Button DockPanel.Dock="Right" Content="Attach" Command="{Binding DataContext.OpenChatAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding DataContext.MessageDraft, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                    </DockPanel>
                                </Grid>

                                <ScrollViewer x:Name="TransferPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                                                <StackPanel>
                                                    <TextBlock Text="Send files" Style="{StaticResource CardTitle}" />
                                                    <TextBlock Text="Pick an accepted friend. Files are hashed in streams before the request; the receiver must accept before any byte moves." Style="{StaticResource MutedText}" Margin="0,6,0,12" />
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Choose files…" Command="{Binding DataContext.OpenFilesCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                                        <ComboBox ItemsSource="{Binding DataContext.Friends, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SelectedFriend, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="User.DisplayName" Background="#10141F" Foreground="#EDF0F7" BorderBrush="{StaticResource Line}" Padding="10,8" VerticalContentAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="You can also drag files onto the window at any time." Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Width="300">
                                                <StackPanel>
                                                    <TextBlock Text="Incoming request" Style="{StaticResource CardTitle}" />
                                                    <TextBlock Text="{Binding DataContext.SelectedIncomingTransfer.Items[0].FileName, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue=No pending request}" Foreground="{StaticResource Muted}" Margin="0,8,0,12" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Accept" Command="{Binding DataContext.AcceptTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                                        <Button Content="Decline" Command="{Binding DataContext.DeclineTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource DangerButton}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="Transfer activity" Style="{StaticResource CardTitle}" />
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}">
                                                        <TextBlock Text="Server Relay" Style="{StaticResource StatusText}" />
                                                    </Border>
                                                </DockPanel>
                                                <ProgressBar Value="{Binding DataContext.TransferPercent, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Maximum="100" Style="{StaticResource ProgressStyle}" Margin="0,14,0,7" />
                                                <DockPanel>
                                                    <TextBlock Text="{Binding DataContext.TransferSpeed, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DataContext.TransferEta, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, StringFormat=ETA {0}}" Foreground="{StaticResource Muted}" FontSize="12" />
                                                </DockPanel>
                                                <WrapPanel Margin="0,13,0,0">
                                                    <Button Content="Pause" Command="{Binding DataContext.PauseTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                                                    <Button Content="Resume" Command="{Binding DataContext.ResumeTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                                                    <Button Content="Retry" Command="{Binding DataContext.RetryTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                                                    <Button Content="Cancel" Command="{Binding DataContext.CancelTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource DangerButton}" Margin="0,0,0,8" />
                                                </WrapPanel>
                                                <ItemsControl ItemsSource="{Binding DataContext.TransferLogs, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3" FontSize="11.5" /></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Direct P2P and Direct Wi-Fi are unavailable; bytes move over the named Server Relay only." Foreground="#C5BFFF" TextWrapping="Wrap" FontSize="11.5" Margin="0,12,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer x:Name="HistoryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Recent transfers" Style="{StaticResource CardTitle}" />
                                            <ItemsControl ItemsSource="{Binding DataContext.Transfers, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,12,0,0">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border Background="{StaticResource SurfaceAlt}" CornerRadius="11" Padding="13" Margin="0,5">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,3" Background="#221B3D">
                                                                    <TextBlock Text="{Binding Status}" Foreground="#B8ADFF" FontSize="10.5" FontWeight="SemiBold" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Transport}" Foreground="{StaticResource Good}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                                    <StackPanel Margin="0,3">
                                                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                                        <ProgressBar Value="{Binding ReceivedBytes, Mode=OneWay}" Maximum="{Binding Size, Mode=OneWay}" Style="{StaticResource ProgressStyle}" Margin="0,4,0,0" />
                                                                    </StackPanel>
                                                                </DataTemplate></ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding Id}" Foreground="#6E7789" FontSize="10" Margin="0,7,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>

                                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Account" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="{Binding DataContext.SignedInName, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,0" FontSize="13" />
                                                <TextBlock Text="{Binding DataContext.BackendStatus, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                    <Button Content="Check connection" Command="{Binding DataContext.RefreshBackendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" />
                                                    <Button Content="Sign out" Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Security" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="Access tokens auto-refresh and live in Windows Credential Manager (DPAPI, per user). Refresh credentials rotate on every refresh; reuse of a rotated token is rejected by the server." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                                                <TextBlock Text="Transfers are authorized per participant: only the sender uploads chunks, only the receiver downloads, and every file is SHA-256 verified during assembly." Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="About" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="HoshinoTransfer · native WPF (.NET 8). Production endpoint is fixed in the application; self-hosted instances can override it with HOSHINOTRANSFER_API_URL." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding}" Value="Home"><Setter TargetName="HomePage" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="Friends"><Setter TargetName="FriendsPage" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="Devices"><Setter TargetName="DevicesPage" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="Chat"><Setter TargetName="ChatPage" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="Transfer"><Setter TargetName="TransferPage" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="History"><Setter TargetName="HistoryPage" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="Settings"><Setter TargetName="SettingsPage" Property="Visibility" Value="Visible" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <TextBlock Grid.Row="2" Text="{Binding BackendStatus}" Foreground="#6E7789" FontSize="10.5" Margin="0,14,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
