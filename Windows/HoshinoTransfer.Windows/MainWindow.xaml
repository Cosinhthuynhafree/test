<Window x:Class="HoshinoTransfer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoshinoTransfer" Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0E1118" Foreground="#F3F4F8">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#8B7BFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AEB5C7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#202636" /><Setter Property="Foreground" Value="White" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Opacity" Value="0.75" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#10141D" />
            <Setter Property="Foreground" Value="#F3F4F8" />
            <Setter Property="BorderBrush" Value="#2A3140" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="LoginView">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsAuthenticated}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Border Width="430" Padding="38" Background="#171B26" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="15" Background="#292442" HorizontalAlignment="Left" Margin="0,0,0,22">
                        <TextBlock Text="H" Foreground="#B8ADFF" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="HoshinoTransfer" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Your files, between your devices." Foreground="#A3AABC" Margin="0,8,0,28" />

                    <TextBlock Text="Display name" Foreground="#C8CDDA" Margin="0,0,0,7">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRegisterMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16">
                        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource InputBox}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRegisterMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBox.Style>
                    </TextBox>

                    <TextBlock Text="Username" Foreground="#C8CDDA" Margin="0,0,0,7" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,0,0,16" />
                    <TextBlock Text="Password" Foreground="#C8CDDA" Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" Background="#10141D" Foreground="#F3F4F8" BorderBrush="#2A3140" BorderThickness="1" Padding="13,11" FontSize="14" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8F9B" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button Content="{Binding BusyLabel}" Command="{Binding SubmitAuthCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" />
                    <Button Content="{Binding AuthModePrompt}" Command="{Binding ToggleAuthModeCommand}" Background="Transparent" Foreground="#B8ADFF" BorderThickness="0" Padding="4,13" HorizontalAlignment="Center" Cursor="Hand" />
                    <TextBlock Text="TLS connection · passwords are protected with scrypt" Foreground="#777F91" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="AppView">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsAuthenticated}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#131720" BorderBrush="#222836" BorderThickness="0,0,1,0" Padding="18,24">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="6,0,0,34">
                            <Border Width="34" Height="34" CornerRadius="11" Background="#292442" Margin="0,0,11,0"><TextBlock Text="H" Foreground="#B8ADFF" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="HoshinoTransfer" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#697286" Margin="12,0,0,9" />
                        <Button Content="⌂   Home" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Home" />
                        <Button Content="⇄   Transfer" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Transfer" />
                        <Button Content="▣   Devices" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Devices" />
                        <Button Content="♧   Friends" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Friends" />
                        <Button Content="◌   Chat" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Chat" />
                        <Button Content="◷   History" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="History" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="⚙   Settings" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                        <Border Background="#1B202C" CornerRadius="12" Padding="12" Margin="4,18,4,8">
                            <StackPanel>
                                <TextBlock Text="{Binding SignedInName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Personal account" Foreground="#858DA0" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="Sign out" Style="{StaticResource NavButton}" Command="{Binding LogoutCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="38,32,38,30">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,28">
                    <TextBlock Text="{Binding Page}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PageDescription}" Foreground="#979FB1" FontSize="14" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <ContentControl Grid.Row="1" Content="{Binding Page}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Grid>
                                <StackPanel x:Name="HomePage" Visibility="Collapsed">
                                    <Border Background="#171B26" CornerRadius="18" Padding="26" Margin="0,0,0,17">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Welcome back" Foreground="#A3AABC" FontSize="13" />
                                                <TextBlock Text="{Binding DataContext.SignedInName, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,0" />
                                                <TextBlock Text="Your account is ready. Device pairing and file transfer controls will appear here when their native client flows are connected." Foreground="#A3AABC" TextWrapping="Wrap" MaxWidth="550" Margin="0,10,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="56" Height="56" CornerRadius="18" Background="#292442" VerticalAlignment="Top"><TextBlock Text="✦" Foreground="#B8ADFF" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        </Grid>
                                    </Border>
                                    <Border Background="#171B26" CornerRadius="18" Padding="24">
                                        <StackPanel>
                                            <TextBlock Text="Service connection" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DataContext.BackendStatus, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#A3AABC" Margin="0,8,0,17" />
                                            <Button Content="Check connection" Command="{Binding DataContext.RefreshBackendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border x:Name="FeaturePage" Visibility="Collapsed" Background="#171B26" CornerRadius="18" Padding="22" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Capability status" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DataContext.PageDescription, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#A3AABC" FontSize="14" TextWrapping="Wrap" Margin="0,9,0,17" />
                                    </StackPanel>
                                </Border>
                                <ScrollViewer x:Name="FriendsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Background="#171B26" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Find people" FontSize="16" FontWeight="SemiBold" />
                                                <DockPanel Margin="0,12,0,8">
                                                    <Button DockPanel.Dock="Right" Content="Search" Command="{Binding DataContext.SearchUsersCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                                    <TextBox Text="{Binding DataContext.SearchQuery, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                                </DockPanel>
                                                <ListBox ItemsSource="{Binding DataContext.SearchResults, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SelectedSearchUser, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderThickness="0" Foreground="#F3F4F8" MaxHeight="150">
                                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="{Binding Username}" Foreground="#858DA0" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                                <Button Content="Send friend request to selected user" Command="{Binding DataContext.AddSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#171B26" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Add by username" FontSize="16" FontWeight="SemiBold" />
                                                <DockPanel Margin="0,12,0,0">
                                                    <Button DockPanel.Dock="Right" Content="Send request" Command="{Binding DataContext.RequestFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                                    <TextBox Text="{Binding DataContext.FriendUsername, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#171B26" CornerRadius="16" Padding="20">
                                            <StackPanel>
                                                <TextBlock Text="People" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                                <ListBox ItemsSource="{Binding DataContext.Friends, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SelectedFriend, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderThickness="0" Foreground="#F3F4F8" MinHeight="180">
                                                    <ListBox.ItemTemplate><DataTemplate><Border Padding="10,8"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="#B8ADFF" Margin="10,0,0,0" /><StackPanel><TextBlock Text="{Binding User.DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding User.Username}" Foreground="#858DA0" FontSize="11" /></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                                <WrapPanel Margin="0,12,0,0">
                                                    <Button Content="Accept" Command="{Binding DataContext.AcceptFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                                    <Button Content="Reject" Command="{Binding DataContext.RejectFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Background="#343A49" Margin="0,0,8,8" />
                                                    <Button Content="Open chat" Command="{Binding DataContext.SelectFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                                    <Button Content="Remove" Command="{Binding DataContext.RemoveFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Background="#343A49" Margin="0,0,8,8" />
                                                    <Button Content="Block" Command="{Binding DataContext.BlockFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Background="#5A3540" Margin="0,0,8,8" />
                                                    <Button Content="Unblock" Command="{Binding DataContext.UnblockFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Background="#343A49" Margin="0,0,8,8" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Background="#171B26" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                            <StackPanel><TextBlock Text="Register this computer" FontSize="16" FontWeight="SemiBold" /><DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Register" Command="{Binding DataContext.RegisterDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" /><TextBox Text="{Binding DataContext.DeviceName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" /></DockPanel></StackPanel>
                                        </Border>
                                        <Border Background="#171B26" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Pair a device on this account" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="Pairing codes are single-use and expire after five minutes. Both devices must be signed in to this account." Foreground="#A3AABC" TextWrapping="Wrap" Margin="0,6,0,12" />
                                                <WrapPanel>
                                                    <Button Content="Create pairing code" Command="{Binding DataContext.CreatePairingCodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                                    <TextBlock Text="{Binding DataContext.PairingCode, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="20" FontWeight="Bold" Foreground="#B8ADFF" VerticalAlignment="Center" Margin="8,0,12,8" />
                                                </WrapPanel>
                                                <DockPanel Margin="0,8,0,0">
                                                    <Button DockPanel.Dock="Right" Content="Pair with code" Command="{Binding DataContext.PairDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                                    <TextBox Text="{Binding DataContext.PairingCode, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" MaxLength="8" ToolTip="Eight-digit pairing code" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#171B26" CornerRadius="16" Padding="20"><StackPanel><DockPanel><TextBlock Text="Registered devices" FontSize="16" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Revoke selected" Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Background="#5A3540" Padding="12,7"/></DockPanel><ListBox ItemsSource="{Binding DataContext.Devices, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SelectedDevice, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderThickness="0" Foreground="#F3F4F8" Margin="0,10,0,0"><ListBox.ItemTemplate><DataTemplate><Border Background="#202635" CornerRadius="10" Padding="13" Margin="0,4"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#8DD9AE"/><StackPanel><TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Platform}" Foreground="#858DA0" FontSize="11"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Lightning cable transfer is unavailable on this transport stack; it will never be shown as active." Foreground="#A3AABC" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid x:Name="ChatPage" Visibility="Collapsed">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Background="#171B26" CornerRadius="13" Padding="13" Margin="0,0,0,12"><DockPanel><StackPanel><TextBlock Text="{Binding DataContext.CurrentPeerName, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold"/><TextBlock Text="{Binding DataContext.TypingStatus, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#B8ADFF" FontSize="11"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="Authenticated SSE" Foreground="#8DD9AE" /></DockPanel></Border>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding DataContext.Messages, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderThickness="0" Foreground="#F3F4F8" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border Background="#171B26" CornerRadius="11" Padding="12" Margin="0,4"><StackPanel><TextBlock Text="{Binding Content}" TextWrapping="Wrap"/><DockPanel Margin="0,5,0,0"><TextBlock Text="{Binding Timestamp}" Foreground="#858DA0" FontSize="10"/><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#858DA0" FontSize="10"/></DockPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                                    <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Send" Command="{Binding DataContext.SendMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" /><Button DockPanel.Dock="Right" Content="Attach" Command="{Binding DataContext.OpenChatAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Background="#343A49" Margin="0,0,8,0" /><TextBox Text="{Binding DataContext.MessageDraft, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" /></DockPanel>
                                </Grid>
                                <ScrollViewer x:Name="TransferPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Background="#171B26" CornerRadius="16" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Send files" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Choose an accepted friend; selected files are hashed in streams before the transfer request." Foreground="#A3AABC" TextWrapping="Wrap" Margin="0,6,0,12" /><DockPanel><Button DockPanel.Dock="Right" Content="Choose files…" Command="{Binding DataContext.OpenFilesCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" /><ComboBox ItemsSource="{Binding DataContext.Friends, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SelectedFriend, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="User.DisplayName" Background="#10141D" Foreground="#F3F4F8" Padding="10" /></DockPanel></StackPanel></Border>
                                        <Border Background="#171B26" CornerRadius="16" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="Incoming request" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding DataContext.SelectedIncomingTransfer.Items[0].FileName, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue=No pending request}" Foreground="#A3AABC" Margin="0,7"/><WrapPanel><Button Content="Accept &amp; receive" Command="{Binding DataContext.AcceptTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="Decline" Command="{Binding DataContext.DeclineTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Background="#343A49" /></WrapPanel></StackPanel></Border>
                                        <Border Background="#171B26" CornerRadius="16" Padding="20"><StackPanel>
                                            <DockPanel><TextBlock Text="Transfer activity" FontSize="16" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="Server Relay" Foreground="#8DD9AE" FontWeight="SemiBold"/></DockPanel>
                                            <ProgressBar Value="{Binding DataContext.TransferPercent, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Maximum="100" Height="8" Margin="0,13,0,5" Background="#252B39" Foreground="#8B7BFF"/>
                                            <DockPanel><TextBlock Text="{Binding DataContext.TransferSpeed, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#A3AABC"/><TextBlock DockPanel.Dock="Right" Text="{Binding DataContext.TransferEta, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=ETA {0}}" Foreground="#A3AABC"/></DockPanel>
                                            <WrapPanel Margin="0,12,0,0"><Button Content="Pause" Command="{Binding DataContext.PauseTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Background="#343A49" Margin="0,0,8,8" Padding="12,7"/><Button Content="Resume" Command="{Binding DataContext.ResumeTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Background="#343A49" Margin="0,0,8,8" Padding="12,7"/><Button Content="Retry" Command="{Binding DataContext.RetryTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Background="#343A49" Margin="0,0,8,8" Padding="12,7"/><Button Content="Cancel" Command="{Binding DataContext.CancelTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Background="#5A3540" Margin="0,0,8,8" Padding="12,7"/></WrapPanel>
                                            <ItemsControl ItemsSource="{Binding DataContext.TransferLogs, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#A3AABC" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            <TextBlock Text="Direct P2P and Direct Wi-Fi are unavailable. Transfer bytes use the named Server Relay." Foreground="#C5BFFF" TextWrapping="Wrap" Margin="0,12,0,0" />
                                        </StackPanel></Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <ScrollViewer x:Name="HistoryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Border Background="#171B26" CornerRadius="16" Padding="20"><StackPanel><TextBlock Text="Recent transfers" FontSize="16" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding DataContext.Transfers, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#202635" CornerRadius="10" Padding="13" Margin="0,4"><StackPanel><DockPanel><TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="#B8ADFF"/><TextBlock Text="{Binding Transport}" Foreground="#8DD9AE"/></DockPanel><ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding FileName}" Foreground="#F3F4F8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Id}" Foreground="#858DA0" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></ScrollViewer>
                                <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><Border Background="#171B26" CornerRadius="16" Padding="20"><StackPanel><TextBlock Text="Account &amp; service" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding DataContext.BackendStatus, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#A3AABC" Margin="0,9,0,14"/><TextBlock Text="Production API endpoint is fixed in the application. Only Debug builds accept an environment override." Foreground="#A3AABC" TextWrapping="Wrap"/><Button Content="Check connection" Command="{Binding DataContext.RefreshBackendCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border></StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding}" Value="Home"><Setter TargetName="HomePage" Property="Visibility" Value="Visible" /><Setter TargetName="FeaturePage" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="Friends"><Setter TargetName="FriendsPage" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="Devices"><Setter TargetName="DevicesPage" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="Chat"><Setter TargetName="ChatPage" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="Transfer"><Setter TargetName="TransferPage" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="History"><Setter TargetName="HistoryPage" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="Settings"><Setter TargetName="SettingsPage" Property="Visibility" Value="Visible" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <TextBlock Grid.Row="2" Text="{Binding BackendStatus}" Foreground="#697286" FontSize="11" Margin="0,18,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
